---
import Layout from '../layouts/Layout.astro';
import Accommodation from '../components/Accommodation.astro';
import Pager from '../components/Pager.astro';
import { site } from '../data/site';
---

<Layout
	title={`Stay — ${site.couple.one} and ${site.couple.two}`}
	description="Places to stay near Pienza, at every price. · Unterkünfte rund um Pienza, für jedes Budget."
>
	<Accommodation />
	<Pager id="stay" />
</Layout>
