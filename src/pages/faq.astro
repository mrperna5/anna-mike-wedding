---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import Pager from '../components/Pager.astro';
import { site } from '../data/site';
---

<Layout
	title={`One last thing — ${site.couple.one} and ${site.couple.two}`}
	description="A closing note, and how to reach us or our witnesses. · Ein paar letzte Worte und wie ihr uns oder unsere Trauzeugen erreicht."
>
	<Faq />
	<Pager id="faq" />
</Layout>
