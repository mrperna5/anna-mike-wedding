---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import Pager from '../components/Pager.astro';
import { site } from '../data/site';
---

<Layout
	title={`FAQ — ${site.couple.one} and ${site.couple.two}`}
	description="Answers to the questions we keep being asked. · Antworten auf die häufigsten Fragen."
>
	<Faq />
	<Pager id="faq" />
</Layout>
