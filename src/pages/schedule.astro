---
import Layout from '../layouts/Layout.astro';
import Schedule from '../components/Schedule.astro';
import Pager from '../components/Pager.astro';
import { site } from '../data/site';
---

<Layout
	title={`Schedule — ${site.couple.one} and ${site.couple.two}`}
	description="Friday to Sunday, hour by hour. · Von Freitag bis Sonntag, Stunde für Stunde."
>
	<Schedule />
	<Pager id="schedule" />
</Layout>
