---
import Layout from '../layouts/Layout.astro';
import Venue from '../components/Venue.astro';
import Pager from '../components/Pager.astro';
import { site } from '../data/site';
---

<Layout
	title={`Venue — ${site.couple.one} and ${site.couple.two}`}
	description="Where the weekend happens, near Pienza. · Wo das Wochenende stattfindet, bei Pienza."
>
	<Venue />
	<Pager id="venue" />
</Layout>
