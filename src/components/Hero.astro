---
import { site } from '../data/site';
import { hero } from '../data/copy';
import Bi from './Bi.astro';
---

<section class="hero">
	<div class="container hero__inner">
		<p class="kicker hero__kicker"><Bi t={hero.kicker} /></p>

		<h1 class="couple hero__names">
			ANNA<span class="couple__and"><Bi t={hero.and} /></span>MIKE
		</h1>

		<hr class="rule rule--center" />

		<!--<p class="hero__sub"><Bi t={hero.sub} /> </p>-->
		<p class="hero__date"><Bi t={site.dateLong} /> <br> <Bi t={site.city} /> | <Bi t={site.country} /></p>

		<a class="link hero__cta" href="/overview"><Bi t={hero.cta} /></a>
	</div>

	<!-- Full-bleed photographic moment. A real clip now stands in for the
	     flat placeholder field; the gradient stays as a fallback background
	     while the video loads (or if it can't play). Caption stays. -->
	<figure class="hero__photo photo">
		<video
			class="hero__photo-video"
			muted
			loop
			playsinline
			preload="auto"
			poster="/images/hero-poster.jpg"
			aria-hidden="true"
		>
			<source src="/videos/hero.mp4" type="video/mp4" />
		</video>
		<!--<figcaption class="photo__cap"><Bi t={hero.caption} /></figcaption>-->
	</figure>
</section>

<script>
	// Respect reduced-motion preference: leave the poster frame static
	// instead of autoplaying the loop.
	const video = document.querySelector('.hero__photo-video');
	if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		video.play().catch(() => {});
	}
</script>

<!--TODO: Orange into same olive green as it was previously
	and should be that color
	more space between anna and mike-->
<style>
	.hero__inner {
		text-align: center;
		padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4rem);
	}
	.hero__kicker {
		margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
	}
	.hero__names {
		margin: 0;
	}
	.rule--center {
		margin-block: clamp(1.75rem, 4vw, 2.5rem);
	}
	.hero__sub {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--fs-h3);
		color: var(--ink-soft);
		margin: 0 0 0.9rem;
	}
	.hero__date {
		font-family: var(--font-sans);
		font-size: var(--fs-label);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		font-weight: 500;
		color: var(--olive);
		margin: 0;
	}
	.hero__cta {
		display: inline-block;
		margin-top: clamp(2.25rem, 5vw, 3.25rem);
	}
	/* Mobile: a fixed aspect ratio (not a height keyed to vw) keeps the same
	   relative crop of the video on every phone, regardless of screen width —
	   a height-from-vw approach hits its clamp floor on most phones, so two
	   phones with different widths but the same floor height end up with
	   different band aspect ratios and crop the couple differently. */
	.hero__photo {
		aspect-ratio: 8 / 5;
		height: auto;
		margin: 0;
		/* Subtle tonal variation reads as light across the field, not a
		   decorative gradient. Fallback while the video loads / if it can't
		   play — .photo already sets position:relative + overflow:hidden. */
		background-image: linear-gradient(
			180deg,
			color-mix(in srgb, var(--olive) 82%, #fff) 0%,
			var(--olive) 60%,
			color-mix(in srgb, var(--olive) 88%, #000) 100%
		);
	}
	.hero__photo-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* The couple's heads sit in the upper third of the source clip
		   (1280x720), not dead center. On wide/short bands (see the
		   desktop height clamp below), a centered crop removes more off
		   the top than there is headroom for and clips them. Anchoring
		   toward the top of the frame keeps their heads in view and lets
		   the crop eat into the grass/field at the bottom instead, which
		   has plenty of room to spare. */
		object-position: center 20%;
	}
	/* Tablet/desktop: the full-bleed band gets very wide, so an 8:5 ratio
	   would make it absurdly tall — go back to a height-based cap instead. */
	@media (min-width: 48rem) {
		.hero__photo {
			aspect-ratio: unset;
			height: clamp(20rem, 40vw, 32rem);
		}
	}
</style>
