---
// Hand-drawn line icons for the dress-code page. Thin, editorial, monochrome —
// colour comes from CSS (currentColor), never from the icon itself.
//
// Every glyph's ink is sized to roughly the same footprint inside the 24×24
// viewBox (~16–18 units in each direction, centred). Keep new icons within
// that same footprint so nothing reads as smaller or bigger than its
// neighbours once they're all constrained to the same CSS box.
import type { DressIconName } from '../data/dressCode';

interface Props {
	name: DressIconName;
}

const { name } = Astro.props;
---

<svg
	class="dress-icon"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.25"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'pasta' && (
			<>
				<ellipse cx="12" cy="13.5" rx="8.3" ry="2.3" />
				<path d="M3.7 13.5C3.7 13.5 4.7 19.5 12 19.5C19.3 19.5 20.3 13.5 20.3 13.5" />
				<path d="M7.8 11.7C9.4 10.1 10.5 12.5 12 11C13.5 9.5 14.6 12 16.2 10.3" />
				<path d="M8.8 6.3C8.8 6.3 7.8 4.5 8.8 3.5" />
				<path d="M15.2 6.3C15.2 6.3 14.2 4.5 15.2 3.5" />
			</>
		)
	}
	{
		name === 'wine-glass' && (
			<>
				<path d="M4 3H20C20 3 20 11 12 14C4 11 4 3 4 3Z" />
				<line x1="12" y1="14" x2="12" y2="19" />
				<line x1="8" y1="21" x2="16" y2="21" />
			</>
		)
	}
	{
		name === 'sun' && (
			<>
				<circle cx="12" cy="12" r="5.3" />
				<line x1="17.3" y1="6.7" x2="20.13" y2="3.87" />
				<line x1="17.3" y1="17.3" x2="20.13" y2="20.13" />
				<line x1="6.7" y1="17.3" x2="3.87" y2="20.13" />
				<line x1="6.7" y1="6.7" x2="3.87" y2="3.87" />
			</>
		)
	}
	{
		name === 'rings' && (
			<>
				<circle cx="8.5" cy="13.5" r="6.2" />
				<circle cx="15.5" cy="10.5" r="6.2" />
			</>
		)
	}
	{
		name === 'dress' && (
			<>
				<path d="M8.5 4C8.5 4 10 4.6 12 4.6C14 4.6 15.5 4 15.5 4" />
				<path d="M8.5 4C8.5 4 9 7 9.3 10" />
				<path d="M15.5 4C15.5 4 15 7 14.7 10" />
				<path d="M9.3 10C9.3 10 4.5 14.5 4 21H20C19.5 14.5 14.7 10 14.7 10" />
				<path d="M9 13C9 13 8 17 7.5 21" />
				<path d="M15 13C15 13 16 17 16.5 21" />
			</>
		)
	}
	{
		name === 'bow-tie' && (
			<>
				<path d="M5 21V9C5 9 5.5 5.5 9.5 4.2H11.3L12 7.5L12.7 4.2H14.5C18.5 5.5 19 9 19 9V21Z" />
				<path d="M9.5 4.2L12 11" />
				<path d="M14.5 4.2L12 11" />
				<circle cx="12" cy="14.5" r="0.4" fill="currentColor" stroke="none" />
				<circle cx="12" cy="17.5" r="0.4" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'aperol' && (
			<>
				<path d="M5 5C5 5 5 12 12 13C19 12 19 5 19 5" />
				<line x1="5" y1="5" x2="19" y2="5" />
				<line x1="12" y1="13" x2="12" y2="19" />
				<line x1="8" y1="21" x2="16" y2="21" />
				<path d="M16.5 3.2V6H19C19 4.35 17.9 3.2 16.5 3.2Z" />
				<line x1="16.5" y1="4.6" x2="18.5" y2="4.6" />
				<line x1="17.6" y1="3.4" x2="17.6" y2="6" />
				<circle cx="9.5" cy="8.5" r="0.4" fill="currentColor" stroke="none" />
				<circle cx="12.5" cy="7" r="0.4" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'beach-ball' && (
			<>
				<circle cx="12" cy="12" r="8" />
				<path d="M12 4V20" />
				<path d="M12 4C7 7 7 17 12 20" />
				<path d="M12 4C17 7 17 17 12 20" />
			</>
		)
	}
	{
		name === 'swimsuit' && (
			<>
				<path d="M6 5H9L7.5 8Z" />
				<path d="M15 5H18L16.5 8Z" />
				<path d="M9 4H15" />
				<path d="M6 5L4 4" />
				<path d="M18 5L20 4" />
				<path d="M9 14H15L12 21Z" />
				<path d="M9 14L7 13" />
				<path d="M15 14L17 13" />
			</>
		)
	}
</svg>
