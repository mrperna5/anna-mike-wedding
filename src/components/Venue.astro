---
// Two named properties, side by side, each with one photo, a name, an
// address, and a link to the venue's own site. Proper nouns, addresses,
// and URLs aren't translated (same convention as `name`/`url` in
// accommodation.ts).
import { venue, ui, travel } from '../data/copy';
import Bi from './Bi.astro';

// 14/15 May — the wedding runs May 14–16 (see site.dateLong); each venue
// gets one of the first two dates as its eyebrow, paired with the month.
const n = (i: number) => String(i + 14);
---
<section id="venue" class="section">
	<div class="container venue__locations">
		{
			venue.locations.map((loc, i) => (
				<article class="venue__location reveal">
					<p class="venue__location-n" aria-hidden="true">
						{n(i)} <Bi t={travel.month} />
					</p>
					<h2 class="venue__location-name">{loc.name}</h2>
					<hr class="rule" />
					<a
						class="venue__location-address"
						href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.coordinates ?? loc.address.en)}`}
						target="_blank"
						rel="noopener noreferrer"
					>
						<Bi t={loc.address} />
						<span class="visually-hidden">
							{' ('}
							<Bi t={ui.newTab} />)
						</span>
					</a>
					<a
						class="link venue__location-link"
						href={loc.website}
						target="_blank"
						rel="noopener noreferrer"
					>
						<Bi t={ui.haveALook} />
						<span class="visually-hidden">
							{' — '}
							{loc.name} (<Bi t={ui.newTab} />)
						</span>
					</a>
					<figure class="venue__location-photo photo">
						<img src={loc.photo} alt="" loading="lazy" style={`object-position: ${loc.photoFocus} center;`} />
					</figure>
				</article>
			))
		}
	</div>
</section>

<style>
	.venue__locations {
		display: grid;
		gap: clamp(3rem, 8vw, 4rem);
	}
	.venue__location {
		padding-top: clamp(1.5rem, 4vw, 2rem);
		border-top: 1px solid var(--hairline);
	}
	.venue__location-n {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		color: var(--terracotta);
		line-height: 1;
		margin: 0 0 1.25rem;
	}
	.venue__location-name {
		font-size: var(--fs-h1);
		margin: 0;
	}
	.venue__location-address {
		display: block;
		margin: 0;
		font-size: var(--fs-label);
		letter-spacing: var(--track-wide);
		text-transform: uppercase;
		color: var(--olive-muted);
		text-decoration: none;
		transition: color 0.3s var(--ease);
	}
	.venue__location-address:hover,
	.venue__location-address:focus-visible {
		color: var(--terracotta);
	}
	.venue__location-link {
		display: inline-block;
		margin-top: 0.9rem;
	}
	.venue__location-photo {
		aspect-ratio: 4 / 5;
		margin: 1.75rem 0 0;
	}
	.venue__location-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	@media (min-width: 48rem) {
		.venue__locations {
			grid-template-columns: repeat(2, 1fr);
			column-gap: clamp(3rem, 6vw, 5rem);
		}
		.venue__location {
			padding-top: 0;
			border-top: 0;
		}
		.venue__location:first-child {
			padding-right: clamp(1.5rem, 3vw, 2.5rem);
			border-right: 1px solid var(--hairline);
		}
		.venue__location:last-child {
			padding-left: clamp(1.5rem, 3vw, 2.5rem);
		}
	}
</style>
