---
// The weekend: the invitation prose plus the hour-by-hour run of the three
// days. These used to be two pages (overview + schedule) and are now one.
import { schedule } from '../data/schedule';
import { overview, schedule as sched, ui } from '../data/copy';
import Bi from './Bi.astro';
---

<section id="overview" class="section">
	<div class="container">
		<div class="overview reveal">
			<p class="kicker"><Bi t={overview.kicker} /></p>
			<h1 class="overview__head">
				<span class="bi" data-lang="en" set:html={overview.headEn} />
				<span class="bi" data-lang="de" lang="de" set:html={overview.headDe} />
			</h1>
			<div class="overview__body measure">
				<p><Bi t={overview.p1} /></p>
				<p><Bi t={overview.p2} /></p>
				<p><Bi t={overview.p3} /></p>
			</div>
		</div>

		<header class="sched__head reveal">
			<p class="kicker"><Bi t={sched.kicker} /></p>
			<h2 class="sched__title"><Bi t={sched.title} /></h2>
		</header>

		<ol class="sched__list">
			{
				schedule.map((e) => (
					<li class="sched__item reveal">
						<span class="sched__n">{e.n}</span>
						<div class="sched__when">
							<p class="sched__day">
								<Bi t={e.day} />
							</p>
							<p class="sched__date">
								<Bi t={e.date} />
							</p>
						</div>
						<div class="sched__body">
							<h3 class="sched__name">
								<Bi t={e.title} />
							</h3>
							<p class="sched__meta">
								<Bi t={e.time} /> | <Bi t={e.place} />
							</p>
							<p class="sched__blurb">
								<Bi t={e.blurb} />
							</p>
						</div>
					</li>
				))
			}
		</ol>

		<aside class="tip reveal">
			<p class="kicker tip__label"><Bi t={overview.tipLabel} /></p>
			<div class="tip__body">
				<p class="tip__text"><Bi t={overview.tip} /></p>
				<p class="tip__who">
					{overview.tipContact.name}
					<span class="tip__role">
						{' — '}
						<Bi t={overview.tipContact.role} />
					</span>
				</p>
				<a
					class="link tip__link"
					href={`tel:${overview.tipContact.phone.replace(/\s/g, '')}`}
				>
					{overview.tipContact.phone}
				</a>
			</div>
		</aside>
	</div>
</section>

<style>
	.overview__head {
		font-size: var(--fs-h1);
		margin: 1.25rem 0 2rem;
	}
	.overview__body p {
		margin-bottom: 1.5rem;
	}

	.sched__head {
		margin: clamp(3.5rem, 9vw, 6rem) 0 clamp(2rem, 5vw, 3rem);
	}
	.sched__title {
		font-size: var(--fs-h2);
		margin-top: 1rem;
	}
	.sched__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sched__item {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-areas:
			'num when'
			'num body';
		gap: 0.25rem 1.25rem;
		padding: clamp(1.75rem, 4vw, 2.5rem) 0;
		border-top: 1px solid var(--hairline);
	}
	.sched__item:last-child {
		border-bottom: 1px solid var(--hairline);
	}
	.sched__n {
		grid-area: num;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		color: var(--terracotta);
		line-height: 1;
	}
	.sched__when {
		grid-area: when;
	}
	.sched__day {
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		color: var(--ink);
		margin: 0;
	}
	.sched__date {
		font-size: var(--fs-label);
		letter-spacing: var(--track-wide);
		text-transform: uppercase;
		color: var(--olive-muted);
		margin: 0.15rem 0 0.75rem;
	}
	.sched__body {
		grid-area: body;
		max-width: var(--measure);
	}
	.sched__name {
		font-size: var(--fs-h3);
		margin: 0 0 0.5rem;
	}
	.sched__meta {
		font-style: italic;
		font-family: var(--font-display);
		color: var(--olive);
		margin: 0 0 0.85rem;
	}
	.sched__blurb {
		margin: 0 0 0.85rem;
	}
	.sched__dress {
		font-size: var(--fs-small);
		color: var(--olive-muted);
		margin: 0;
	}

	/* The practical aside under the run of the weekend. Same grid and vertical
	   rhythm as a schedule item — label in the day column, prose in the body
	   column — so it reads as the last beat of the list; the contact borrows
	   the phone-book grammar used on /faq and /accommodation. */
	.tip {
		padding: clamp(1.75rem, 4vw, 2.5rem) 0;
	}
	.tip__body {
		max-width: var(--measure);
		margin: 0.75rem 0 0;
	}
	.tip__text {
		margin: 0 0 0.85rem;
	}
	.tip__who {
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		color: var(--ink);
		margin: 0 0 0.85rem;
	}
	.tip__role {
		font-family: var(--font-sans);
		font-size: var(--fs-label);
		letter-spacing: var(--track-wide);
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--olive-muted);
	}
	.tip__link {
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.08em;
		padding-bottom: 0;
		border-bottom: 0;
	}
	.tip__link:hover,
	.tip__link:focus-visible {
		color: var(--terracotta);
	}

	@media (min-width: 48rem) {
		.sched__item {
			grid-template-columns: 4rem 12rem 1fr;
			grid-template-areas: 'num when body';
			gap: 2rem;
			align-items: start;
		}
		/* Line the aside up with the schedule: label where the day sits,
		   prose where the blurbs sit. */
		.tip {
			display: grid;
			grid-template-columns: 4rem 12rem 1fr;
			gap: 2rem;
			align-items: start;
		}
		.tip__label {
			grid-column: 2;
			padding-top: 0.4rem;
		}
		.tip__body {
			grid-column: 3;
			margin-top: 0;
		}
	}
</style>
