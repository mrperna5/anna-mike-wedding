<style>
	.outro-section {
		padding-bottom: clamp(3rem, 7vw, 5rem);
	}
	.outro__head {
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}
	.outro__title {
		font-size: var(--fs-h1);
		margin-top: 1rem;
	}
	.outro__body p {
		margin-bottom: 1.5rem;
	}
	.outro__signoff {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--fs-h3);
		color: var(--olive);
		margin: clamp(0.5rem, 2vw, 1rem) 0 clamp(2rem, 5vw, 3rem);
	}

	/* A little phone-book directory — same grammar as the salon listings
	   that used to sit under the hair FAQ, and the listings on /accommodation. */
	.outro__contacts {
		list-style: none;
		margin: 0;
		padding: 1.75rem 0 0;
		border-top: 1px solid var(--hairline);
		display: grid;
		gap: 1.4rem;
	}
	.outro__contact {
		padding-top: 0;
	}
	.outro__name {
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		color: var(--ink);
		margin: 0 0 0.6rem;
	}
	.outro__role {
		font-family: var(--font-sans);
		font-size: var(--fs-label);
		letter-spacing: var(--track-wide);
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--olive-muted);
	}
	.outro__reach {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
	}
	.outro__link {
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.08em;
		padding-bottom: 0;
		border-bottom: 0;
	}
	.outro__link:hover,
	.outro__link:focus-visible {
		color: var(--terracotta);
	}
	.outro__photo-wrap {
		margin-top: clamp(3.5rem, 8vw, 6rem);
	}
	.outro__photo {
		max-width: 52rem;
		margin: 0 auto;
		aspect-ratio: 3 / 2;
	}
	.outro__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 48rem) {
		.outro__contacts {
			grid-template-columns: repeat(2, 1fr);
			column-gap: 2.5rem;
			row-gap: 1.75rem;
		}
		.outro__link {
			font-size: 0.68rem;
		}
	}
</style>
