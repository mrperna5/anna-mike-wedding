---
import { faq } from '../data/faq';
import { faqCopy } from '../data/copy';
import Bi from './Bi.astro';
---

<section id="faq" class="section">
	<div class="container faq">
		<header class="faq__head reveal">
			<p class="kicker"><Bi t={faqCopy.kicker} /></p>
			<h1 class="faq__title"><Bi t={faqCopy.title} /></h1>
		</header>

		<div class="faq__list">
			{
				faq.map((item) => (
					<details class="faq__item reveal">
						<summary class="faq__q">
							<span>
								<Bi t={item.q} />
							</span>
							<span class="faq__icon" aria-hidden="true" />
						</summary>
						<p class:list={['faq__a', item.places && 'faq__a--lead']}>
							<Bi t={item.a} />
						</p>
						{item.places && (
							<ul class="faq__places">
								{item.places.map((pl) => (
									<li class="faq__place">
										<p class="faq__place-name">{pl.name}</p>
										<p class="faq__place-addr">{pl.address}</p>
										{pl.note && (
											<p class="faq__place-note">
												<Bi t={pl.note} />
											</p>
										)}
										<a class="link faq__tel" href={`tel:${pl.phone.replace(/[^+\d]/g, '')}`}>
											{pl.phone}
										</a>
									</li>
								))}
							</ul>
						)}
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}
	.faq__title {
		font-size: var(--fs-h1);
		margin-top: 1rem;
	}
	.faq__list {
		margin: 0;
	}
	.faq__item {
		border-top: 1px solid var(--hairline);
	}
	.faq__item:last-child {
		border-bottom: 1px solid var(--hairline);
	}
	.faq__q {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		padding: 1.4rem 0;
		cursor: pointer;
		list-style: none;
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		color: var(--ink);
	}
	.faq__q::-webkit-details-marker {
		display: none;
	}
	.faq__icon {
		position: relative;
		flex: 0 0 14px;
		width: 14px;
		height: 14px;
	}
	.faq__icon::before,
	.faq__icon::after {
		content: '';
		position: absolute;
		background: var(--terracotta);
		transition: transform 0.3s var(--ease);
	}
	.faq__icon::before {
		top: 6px;
		left: 0;
		width: 14px;
		height: 1px;
	}
	.faq__icon::after {
		top: 0;
		left: 6px;
		width: 1px;
		height: 14px;
	}
	.faq__item[open] .faq__icon::after {
		transform: scaleY(0);
	}
	.faq__a {
		max-width: var(--measure);
		padding-bottom: 1.5rem;
		margin: 0;
		font-size: var(--fs-small);
	}
	.faq__a--lead {
		padding-bottom: 1rem;
	}

	/* Phone-book list under an answer — the salons. Hairline rows, same
	   grammar as the listings on /accommodation. */
	.faq__places {
		list-style: none;
		margin: 0;
		padding: 0 0 1.75rem;
		display: grid;
		gap: 1.4rem;
	}
	.faq__place {
		padding-top: 1.1rem;
		border-top: 1px solid var(--hairline);
	}
	.faq__place-name {
		font-family: var(--font-display);
		font-size: var(--fs-h3);
		color: var(--ink);
		margin: 0 0 0.25rem;
	}
	.faq__place-addr {
		font-size: var(--fs-small);
		color: var(--olive-muted);
		margin: 0 0 0.7rem;
	}
	.faq__place-note {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--fs-small);
		color: var(--olive);
		margin: -0.3rem 0 0.7rem;
	}
	.faq__tel {
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.08em;
		border-bottom-color: var(--hairline);
	}
	.faq__tel:hover,
	.faq__tel:focus-visible {
		border-bottom-color: var(--terracotta);
	}
	@media (min-width: 48rem) {
		.faq {
			grid-template-columns: 16rem 1fr;
			align-items: start;
		}
		.faq__places {
			grid-template-columns: repeat(2, 1fr);
			column-gap: 2.5rem;
		}
		.faq__tel {
			font-size: 0.68rem;
		}
	}
</style>
