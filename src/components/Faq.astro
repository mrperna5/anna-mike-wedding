---
// Formerly the FAQ list. Replaced with a closing note + a little directory
// of us and our witnesses. The old Q&A rendering is commented out below
// rather than deleted, and its data still lives untouched in
// src/data/faq.ts, in case this page ever needs to come back.
// import { faq } from '../data/faq';
// import { faqCopy } from '../data/copy';
import { outro, outroContacts } from '../data/copy';
import Bi from './Bi.astro';
---

<section id="faq" class="section outro-section">
	<div class="container outro measure">
		<header class="outro__head reveal">
			<p class="kicker"><Bi t={outro.kicker} /></p>
			<h1 class="outro__title"><Bi t={outro.title} /></h1>
		</header>

		<div class="outro__body reveal">
			<p><Bi t={outro.p1} /></p>
			<p><Bi t={outro.p2} /></p>
			<p><Bi t={outro.p3} /></p>
		</div>

		<p class="outro__signoff reveal"><Bi t={outro.signoff} /></p>

		<ul class="outro__contacts reveal">
			{
				outroContacts.map((c) => (
					<li class="outro__contact">
						<p class="outro__name">
							{c.name}
							{c.role && (
								<span class="outro__role">
									{' — '}
									<Bi t={c.role} />
								</span>
							)}
						</p>
						<p class="outro__reach">
							{c.email && (
								<a class="link outro__link" href={`mailto:${c.email}`}>
									{c.email}
								</a>
							)}
							<a class="link outro__link" href={`tel:${c.phone.replace(/\s/g, '')}`}>
								{c.phone}
							</a>
						</p>
					</li>
				))
			}
		</ul>
	</div>

	<div class="container outro__photo-wrap">
		<figure class="outro__photo photo reveal">
			<img
				src="/images/anna-mike-holding-hands.jpeg"
				alt="Anna and Mike holding hands"
				width="2000"
				height="1333"
				loading="lazy"
			/>
		</figure>
	</div>
</section>

